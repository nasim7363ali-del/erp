# Copy to .env and fill ALL values before docker compose up --build.
# Generate independent secrets, e.g. openssl rand -hex 32. Do not commit .env.
POSTGRES_PASSWORD=
ERP_API_PASSWORD=
JWT_SECRET=
TOTP_ENC_KEY=
# Use the SAME ERP_API_PASSWORD below, URL-encoded if it has special characters.
DATABASE_URL=postgres://erp_api:REPLACE_WITH_API_PASSWORD@db:5432/erp
APP_PORT=3000
REQUIRE_2FA=managers
