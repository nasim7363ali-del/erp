{
  "name": "rifd-erp",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "dev:design": "npm run dev:design --workspace web",
    "build": "npm run typecheck --workspace api && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspace api",
    "test:docker": "docker compose -f docker-compose.test.yml run --build --rm test",
    "db:rebuild:dev": "bash db/make_demo.sh",
    "start": "npm start --workspace api",
    "test:db-script": "bash scripts/test-db-build.sh"
  }
}
